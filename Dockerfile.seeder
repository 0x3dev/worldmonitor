FROM node:22-alpine
WORKDIR /app
ENV NODE_OPTIONS=--dns-result-order=ipv4first

# Root deps (skip postinstall — it tries to build blog-site)
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# Full source incl. scripts/
COPY . .

# Seeders pull a few deps from scripts/package.json
RUN npm install --prefix scripts --no-audit --no-fund

# Curated Railway list (tracked in-repo) — not run-seeders.sh, which sweeps
# every seed-*.mjs including domains this deployment doesn't serve.
CMD ["sh", "scripts/run-seeders-railway.sh"]
